# Copy to `.env` (never commit `.env`). Every variable is validated at startup by
# backend/src/core/config.ts; the server refuses to start if a required one is missing.
# [required] = no default.  Values shown are safe for local development only.

# --- Application ---------------------------------------------------------------------------
NODE_ENV=development            # development | test | production
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
APP_BASE_URL=http://localhost:5173   # public URL of the frontend; used in e-mail links
APP_TIMEZONE=Europe/Chisinau    # daily upload counter and reminders use this zone (C-07)

# --- Database (PostgreSQL 16) --------------------------------------------------------------
# [required] Without Docker (e.g. Postgres.app): postgres://localhost:5432/recap_dev
#            With Docker Compose the backend container overrides it with the `db` service.
DATABASE_URL=postgres://localhost:5432/recap_dev
DATABASE_POOL_MAX=10
# Used only by `make test`; the test suite DROPS AND RECREATES every table in it.
TEST_DATABASE_URL=postgres://localhost:5432/recap_test
# Used only by docker-compose.yml for the `db` service.
POSTGRES_USER=recap
POSTGRES_PASSWORD=recap
POSTGRES_DB=recap

# --- Session -------------------------------------------------------------------------------
# [required] At least 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=24            # 1–24 (RF2: at most 24 hours)
SESSION_COOKIE_NAME=recap_session

# --- Language model (one model, called only from the server) -------------------------------
LLM_PROVIDER=fake               # `fake` = built-in deterministic client (no key, no network)
LLM_MODEL=                      # [required unless LLM_PROVIDER=fake]
LLM_API_KEY=                    # [required unless LLM_PROVIDER=fake] never sent to the browser
LLM_BASE_URL=                   # optional override of the provider endpoint

# --- E-mail (SMTP) -------------------------------------------------------------------------
SMTP_HOST=localhost             # [required]
SMTP_PORT=1025
SMTP_SECURE=false               # true in production (encrypted SMTP)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Recap <no-reply@localhost>   # [required]

# --- Uploads -------------------------------------------------------------------------------
UPLOAD_DIR=./storage/uploads    # where uploaded files are kept (a Docker volume in Compose)
UPLOAD_HARD_LIMIT_MB=50         # transport cap; RF25 lets the admin choose 1–50 MB below it
UPLOAD_MAX_PAGES=100
# Initial values of the admin-editable settings, written by `make seed` on a fresh database:
DEFAULT_MAX_FILE_SIZE_MB=20
DEFAULT_UPLOADS_PER_DAY=10

# --- Background worker ---------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=1000
