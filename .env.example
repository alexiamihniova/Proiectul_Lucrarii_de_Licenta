# Copy to `.env` (`make env` does it and generates SESSION_SECRET). Never commit `.env`.
# Every variable is validated at startup by backend/src/core/config.ts; the server refuses
# to start when a [required] one is missing. Values below are safe for local development only.
# Keep comments on their own lines: this file is read by Node, Docker Compose and make.

# --- Application ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public URL of the frontend; used in e-mail links (password reset, unsubscribe).
APP_BASE_URL=http://localhost:5173
# The daily upload counter and the reminders use this time zone (C-07).
APP_TIMEZONE=Europe/Chisinau

# --- Database (PostgreSQL 16) --------------------------------------------------------------
# [required] Used when running WITHOUT Docker (e.g. Postgres.app).
# With Docker Compose the containers ignore it and connect to the `db` service.
DATABASE_URL=postgres://localhost:5432/recap_dev
DATABASE_POOL_MAX=10
# Used only by `make test`. The test suite DROPS AND RECREATES every table in this database;
# its name must contain "test".
TEST_DATABASE_URL=postgres://localhost:5432/recap_test
# Used only by infra/docker-compose.yml for the `db` service.
POSTGRES_USER=recap
POSTGRES_PASSWORD=recap
POSTGRES_DB=recap

# --- Session -------------------------------------------------------------------------------
# [required] At least 32 characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=
# 1–24 (RF2: a session lasts at most 24 hours)
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=recap_session

# --- Language model (one model, called only from the server) -------------------------------
# `fake` = built-in deterministic client: no key, no network. Not allowed in production.
LLM_PROVIDER=fake
# [required unless LLM_PROVIDER=fake]
LLM_MODEL=
# [required unless LLM_PROVIDER=fake] Never sent to the browser, never logged.
LLM_API_KEY=
# Optional override of the provider endpoint.
LLM_BASE_URL=

# --- E-mail (SMTP) -------------------------------------------------------------------------
# [required]
SMTP_HOST=localhost
SMTP_PORT=1025
# true in production (encrypted SMTP)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# [required]
SMTP_FROM="Recap <no-reply@localhost>"

# --- Uploads -------------------------------------------------------------------------------
# Where uploaded files are kept (a Docker volume when running in Compose).
UPLOAD_DIR=./storage/uploads
# Transport cap in MB; RF25 lets the administrator choose 1–50 MB below it.
UPLOAD_HARD_LIMIT_MB=50
UPLOAD_MAX_PAGES=100
# Initial values of the admin-editable settings, written by `make seed` on a fresh database.
DEFAULT_MAX_FILE_SIZE_MB=20
DEFAULT_UPLOADS_PER_DAY=10

# --- Background worker ---------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=1000
